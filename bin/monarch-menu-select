#!/bin/bash

# monarch:summary=Pick one option from the Monarch menu
# monarch:group=menu
# monarch:name=select
# monarch:args=prompt [option...]
# monarch:examples=monarch menu select Format jpg png|monarch-menu-select Resolution 4k 1080p 720p

set -euo pipefail

if (( $# < 1 )); then
  echo "Usage: monarch-menu-select <prompt> [option...]" >&2
  exit 1
fi

prompt="$1"
shift

options=()

while (( $# > 0 )); do
  if [[ $1 == "--" ]]; then
    break
  fi

  options+=("$1")
  shift
done

if (( ${#options[@]} == 0 )) && [[ ! -t 0 ]]; then
  mapfile -t options
fi

if (( ${#options[@]} == 0 )); then
  echo "Usage: monarch-menu-select <prompt> [option...]" >&2
  exit 1
fi

# Walker's dmenu mode shows one label per line and prints the chosen line.
# The label is "glyph label detail"; the printed value is the option's value
# (its fourth tab field, else label[TAB]detail, else the label).
labels=()
values=()
for option in "${options[@]}"; do
  IFS=$'\t' read -r a b c d <<<"$option"
  if [[ -z ${b:-} ]]; then
    labels+=("$a"); values+=("$a")
  else
    labels+=("$a  $b${c:+  $c}")
    if [[ -n ${d:-} ]]; then values+=("$d")
    elif [[ -n ${c:-} ]]; then values+=("$b"$'\t'"$c")
    else values+=("$b"); fi
  fi
done

choice=$(printf '%s\n' "${labels[@]}" | walker --dmenu --placeholder "$prompt") || exit 1
[[ -n $choice ]] || exit 1
for index in "${!labels[@]}"; do
  if [[ ${labels[index]} == "$choice" ]]; then
    printf '%s\n' "${values[index]}"
    exit 0
  fi
done
exit 1
