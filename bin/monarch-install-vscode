#!/bin/bash

# monarch:summary=Install VS Code and configure Monarch defaults for secrets, updates, and the rendered Monarch theme

echo "Installing VSCode..."
monarch-pkg-add visual-studio-code-bin

mkdir -p ~/.vscode ~/.config/Code/User

cat > ~/.vscode/argv.json << 'EOF'
// This configuration file allows you to pass permanent command line arguments to VS Code.
// Only a subset of arguments is currently supported to reduce the likelihood of breaking
// the installation.
//
// PLEASE DO NOT CHANGE WITHOUT UNDERSTANDING THE IMPACT
//
// NOTE: Changing this file requires a restart of VS Code.
{
  "password-store":"gnome-libsecret"
}
EOF

# Monarch theme: a small local extension whose two themes are the files
# monarch-theme-render writes (Monarch Dark and Monarch Light). They are linked,
# so every re-render is picked up. Schema-shaped, not yet checked in a running
# VS Code.
ext="$HOME/.vscode/extensions/monarch.monarch-theme-1.0.0"
mkdir -p "$ext/themes"
cp "${MONARCH_PATH:-/usr/share/monarch}/default/monarch/vscode-extension/package.json" "$ext/package.json"
ln -sfn "$HOME/.config/monarch/current/theme/vscode-dark.json" "$ext/themes/monarch-dark.json"
ln -sfn "$HOME/.config/monarch/current/theme/vscode-light.json" "$ext/themes/monarch-light.json"
monarch-theme-render >/dev/null 2>&1 || true

# Fresh installs get VS Code's own auto-update turned off and the Monarch theme
# following the system dark/light setting. An existing settings.json is never
# rewritten.
settings="$HOME/.config/Code/User/settings.json"
if [[ ! -f $settings ]]; then
  cat >"$settings" <<'JSON'
{
  "update.mode": "none",
  "window.autoDetectColorScheme": true,
  "workbench.preferredDarkColorTheme": "Monarch Dark",
  "workbench.preferredLightColorTheme": "Monarch Light"
}
JSON
elif ! grep -q 'Monarch ' "$settings"; then
  echo 'Note: select the "Monarch Dark" / "Monarch Light" color theme in VS Code to follow the Monarch theme.'
fi

setsid gtk-launch code
