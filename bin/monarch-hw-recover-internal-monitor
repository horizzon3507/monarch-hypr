#!/bin/bash

# monarch:summary=Re-enable the laptop display if the external monitor is unplugged while it was off
# monarch:hidden=true

# Safety net for monarch-hypr-monitor-internal. It disables the panel through
# the persisted runtime overrides, so a reboot already restores it. The real
# danger is unplugging the external monitor mid-session, which leaves the panel
# off with no display. This is a long-running watcher: Hyprland's event socket
# reports every monitor added or removed, and on each one, if the internal panel
# is off AND no external monitor is connected, we turn it back on.

set -uo pipefail

internal_output() {
  local output
  while IFS= read -r output; do
    monarch-hw-display-internal "$output" || continue
    printf '%s\n' "$output"
    return
  done < <(hyprctl monitors all -j 2>/dev/null | jq -r '.[].name')
  return 1
}

recover() {
  local internal=$1
  hyprctl monitors all -j 2>/dev/null \
    | jq -e --arg m "$internal" '.[] | select(.name == $m) | .disabled' >/dev/null || return
  # Only rescue the panel when it is the last display standing.
  monarch-hw-external-monitors && return
  monarch-hypr-output-set "$internal" power on >/dev/null 2>&1
  notify-send -u normal "󰍹    Laptop display restored" \
    "External monitor disconnected while the laptop screen was off."
}

# Sourcing stops here so tests can drive the discovery above without entering
# the watch loop.
[[ ${BASH_SOURCE[0]} == "$0" ]] || return 0

# Reconnect loop: the stream ends when Hyprland restarts; the sleep also guards a
# hot spin while its socket is not up yet.
while true; do
  if signature=$(monarch-hw-hypr-instance); then
    export HYPRLAND_INSTANCE_SIGNATURE=$signature
    socat -U - "UNIX-CONNECT:${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr/$signature/.socket2.sock" 2>/dev/null |
      while IFS= read -r line; do
        [[ $line == monitorremoved* || $line == monitoradded* ]] || continue
        internal=$(internal_output)
        [[ -n $internal ]] && recover "$internal"
        # Same unplug event: tear down a display mirror left pointing at a now-gone
        # external output (otherwise wl-mirror strands a hall-of-mirrors on the panel).
        monarch-hypr-monitor-internal-mirror recover
      done
  fi
  sleep 2
done
