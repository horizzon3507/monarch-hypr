#!/bin/bash

# monarch:summary=Show the active Hyprland key bindings, searchable in Walker
# monarch:args=[--print|--json]
# monarch:examples=monarch menu keybindings | monarch menu keybindings --print

# Reads the live bindings from Hyprland (`hyprctl binds -j`), so it shows what
# the compositor actually has loaded, including the user's own bindings.lua.
# Bindings without a description are skipped: the description is the label.

set -uo pipefail

# Hyprland reports the modifier mask as a bit set.
modifier_names() {
  local mask=$1 out=()
  ((mask & 64)) && out+=(SUPER)
  ((mask & 8)) && out+=(ALT)
  ((mask & 4)) && out+=(CTRL)
  ((mask & 1)) && out+=(SHIFT)
  local IFS=' '
  echo "${out[*]}"
}

output_keybindings() {
  local rows mask key description mods shortcut
  rows=$(hyprctl binds -j 2>/dev/null | jq -r '
    .[] | select((.description // "") != "")
    | [(.modmask // 0), (.key // .keycode // ""), .description] | @tsv') || return 1
  while IFS=$'\t' read -r mask key description; do
    [[ -n $description ]] || continue
    mods=$(modifier_names "$mask")
    shortcut="${mods:+$mods + }$key"
    printf '%s  →  %s\n' "$shortcut" "$description"
  done <<<"$rows" | sort -u
}

output_keybindings_json() {
  output_keybindings | jq -Rsc '
    split("\n")
    | map(
        capture("^(?<shortcut>.*?)  →  (?<label>.*)$")?
        | select(.)
        | . + {searchText: (.label + " " + .shortcut)}
      )
  '
}

case ${1:-} in
  --print | -p)
    output_keybindings
    ;;
  --json)
    output_keybindings_json
    ;;
  "")
    output_keybindings | walker --dmenu --placeholder "Key bindings" >/dev/null
    ;;
  *)
    echo "Usage: monarch-menu-keybindings [--print|--json]" >&2
    exit 1
    ;;
esac
