#!/bin/bash

# monarch:summary=List the displays Hyprland sees, with their state, scale and mode
# monarch:group=display
# monarch:examples=monarch display list

# name<TAB>state<TAB>scale<TAB>mode<TAB>focused<TAB>description — description goes
# last, being the only field that may contain a tab.
#
# A disabled output still appears, with no scale and no mode: Hyprland keeps
# reporting it so it can be turned back on by name.

set -uo pipefail

# A shell-launched process's PATH can be /usr/local/sbin:/usr/local/bin:/usr/bin — Monarch's bin is
# not on it, so a sibling called by name is simply not found when the shell runs
# this. Appended and not prepended: this only adds a fallback, and never takes a
# command away from a caller that put its own ahead of ours.
PATH="$PATH:$(cd -- "${BASH_SOURCE[0]%/*}" && pwd)"

HYPRLAND_INSTANCE_SIGNATURE=$(monarch-hw-hypr-instance) || {
  echo "Error: Hyprland is not running." >&2
  exit 1
}
export HYPRLAND_INSTANCE_SIGNATURE

focused=$(monarch-hypr-monitor-focused)

hyprctl monitors all -j 2>/dev/null | jq -r --arg focused "$focused" '
  .[]
  | [
      .name,
      (if .disabled then "off" else "on" end),
      (.scale | tostring),
      (if .disabled then "" else "\(.width)x\(.height)@\(.refreshRate | floor)" end),
      (if .name == $focused then "focused" else "" end),
      ([.make, .model] | map(select(. != null and . != "")) | join(" "))
    ]
  | @tsv
'
