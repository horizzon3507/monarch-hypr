#!/bin/bash

# monarch:summary=Get or set the desktop wallpaper (Hyprpaper)
# monarch:args=<get|set <path>>
# monarch:examples=monarch wallpaper get | monarch wallpaper set ~/Pictures/wall.png

LINK="${XDG_CONFIG_HOME:-$HOME/.config}/monarch/current/background"

case "${1:-}" in
  get)
    [[ -L $LINK ]] && readlink -f "$LINK"
    exit 0
    ;;
  set)
    path=${2:-}
    [[ -f $path ]] || { echo "Wallpaper not found: ${path:-<none>}" >&2; exit 1; }
    mkdir -p "${LINK%/*}"
    ln -sfn "$(readlink -f "$path")" "$LINK" || exit 1
    # Hyprpaper reads the link at start; the live call updates a running daemon.
    if pgrep -x hyprpaper >/dev/null 2>&1; then
      hyprctl hyprpaper wallpaper ",$LINK,cover" >/dev/null 2>&1 || {
        pkill -x hyprpaper
        setsid --fork uwsm-app -t service -- hyprpaper >/dev/null 2>&1
      }
    fi
    ;;
  *)
    echo "Usage: monarch wallpaper <get|set <path>>" >&2
    exit 1
    ;;
esac
