#!/bin/bash

# monarch:summary=Get or set the desktop wallpaper (Quickshell shell)
# monarch:args=<get|set <path>>
# monarch:examples=monarch wallpaper get | monarch wallpaper set ~/Pictures/wall.png

LINK="${XDG_CONFIG_HOME:-$HOME/.config}/monarch/current/background"

case "${1:-}" in
  get)
    [[ -L $LINK ]] && readlink -f "$LINK"
    exit 0
    ;;
  set)
    path=${2:-}
    [[ -f $path ]] || { echo "Wallpaper not found: ${path:-<none>}" >&2; exit 1; }
    mkdir -p "${LINK%/*}"
    ln -sfn "$(readlink -f "$path")" "$LINK" || exit 1
    # The Quickshell shell draws the wallpaper and reloads on this state file.
    monarch-wallpaper-sync || exit 1
    ;;
  *)
    echo "Usage: monarch wallpaper <get|set <path>>" >&2
    exit 1
    ;;
esac
