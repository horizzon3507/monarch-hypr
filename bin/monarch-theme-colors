#!/bin/bash

# monarch:summary=Print the resolved theme colors for the active or named Monarch scheme as JSON
# monarch:args=[name]
# monarch:examples=monarch theme colors|monarch theme colors | jq -r .mPrimary

# Assembles the resolved colors of the active palette: its dark or light half,
# picked by the resolved theme mode. Output is the object with mPrimary,
# mSurface, mOnSurface and the rest, read from ~/.config/monarch/palettes.
#
# Only schemes with a palette file can be served.

set -uo pipefail

command -v jq >/dev/null 2>&1 || { echo "jq is required" >&2; exit 1; }
command -v monarch-theme-current >/dev/null 2>&1 || { echo "monarch-theme-current is not on PATH" >&2; exit 1; }

requested=${1:-}
if [[ -n $requested ]]; then
  scheme="custom $requested"
else
  scheme=$(monarch-theme-current 2>&1) ||
    { echo "Cannot read the active color scheme ($scheme)" >&2; exit 1; }
fi

mode=$(monarch-theme-mode get 2>/dev/null)
[[ $mode == dark || $mode == light ]] ||
  { echo "Unusable theme mode: '$mode'" >&2; exit 1; }

# color-scheme-get answers "<source> <name>", and names carry spaces.
source=${scheme%% *}
name=${scheme#* }

case "$source" in
  custom) dir="$HOME/.config/monarch/palettes" ;;
  *)
    echo "The active color scheme \"$source $name\" has no palette file to read" >&2
    exit 1
    ;;
esac

palette="$dir/$name.json"
[[ -f $palette ]] ||
  { echo "No palette file for \"$source $name\" in $dir" >&2; exit 1; }

jq -e --arg m "$mode" '.[$m] // empty' "$palette" ||
  { echo "Palette $palette carries no \"$mode\" colors" >&2; exit 1; }
