#!/bin/bash

# monarch:summary=Toggle the battery percentage in the Quickshell bar
# monarch:args=[toggle|on|off|status]
# monarch:examples=monarch toggle battery-percentage | monarch toggle battery-percentage status

set -uo pipefail

STATE="$HOME/.local/state/monarch/toggles/battery-percentage"

percentage_enabled() {
  [[ -f $STATE ]]
}

set_percentage() {
  local state=$1 value=false
  [[ $state == "on" ]] && value=true
  monarch-shell-setting set batteryPercent "$value" || return 1
  if [[ $state == "on" ]]; then
    mkdir -p "${STATE%/*}"
    : >"$STATE"
  else
    rm -f "$STATE"
  fi
}

print_status() {
  if percentage_enabled; then
    printf '{"enabled":true,"tooltip":"Battery percentage visible - hide it"}\n'
  else
    printf '{"enabled":false,"tooltip":"Battery percentage hidden - show it"}\n'
  fi
}

case "${1:-toggle}" in
  toggle)
    if percentage_enabled; then set_percentage off; else set_percentage on; fi
    ;;
  on) set_percentage on ;;
  off) set_percentage off ;;
  status | --status) print_status ;;
  *)
    echo "Usage: $0 [toggle|on|off|status]" >&2
    exit 1
    ;;
esac
