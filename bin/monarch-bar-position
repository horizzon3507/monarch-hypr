#!/bin/bash

# monarch:summary=Show or set the Quickshell bar position
# monarch:args=[top|bottom]
# monarch:examples=monarch bar position | monarch bar position bottom

set -euo pipefail

# The bar anchors to the top or the bottom edge only; left and right are not
# supported by this shell, so they are refused instead of silently ignored.
current_position() {
  local position
  position=$(monarch-shell-setting get barPosition 2>/dev/null || true)
  case "$position" in
    top | bottom) printf '%s\n' "$position" ;;
    *) printf 'top\n' ;;
  esac
}

case "${1:-}" in
  "") current_position ;;
  top | bottom) monarch-shell-setting set barPosition "\"$1\"" ;;
  *)
    echo "Usage: $0 [top|bottom]" >&2
    exit 1
    ;;
esac
