#!/bin/bash

# monarch:summary=Toggle masking of chat windows in screen captures
# monarch:args=[toggle|on|off|status]
# monarch:examples=monarch toggle chat-privacy status

# The masking rules live in default/hypr/rules.lua, which reads the
# chat-privacy-off flag when Hyprland loads its config. This command owns that
# flag and asks the running Hyprland to reload so the change applies now. A
# failed reload restores the previous flag state and fails, so the state shown
# always matches what was applied. Outside a Hyprland session the flag is kept
# and applies at the next login.

set -euo pipefail

root=${MONARCH_PATH:-/usr/share/monarch}
flag=$HOME/.local/state/monarch/toggles/chat-privacy-off

enabled() {
  [[ ! -f $flag ]]
}

reload_hyprland() {
  [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] || return 0
  hyprctl reload >/dev/null 2>&1
}

set_state() {
  local desired=$1 current=on
  [[ -f $flag ]] && current=off
  [[ $current != "$desired" ]] || return 0
  "$root/bin/monarch-toggle" chat-privacy-off
  if ! reload_hyprland; then
    "$root/bin/monarch-toggle" chat-privacy-off
    echo "Could not reload Hyprland; chat masking is unchanged." >&2
    return 1
  fi
}

case ${1:-toggle} in
  status | --status)
    if enabled; then
      printf '{"enabled":true,"tooltip":"Show chat windows in captures"}\n'
    else
      printf '{"enabled":false,"tooltip":"Mask chat windows in captures"}\n'
    fi
    ;;
  on)
    set_state on
    ;;
  off)
    set_state off
    ;;
  toggle)
    if enabled; then
      set_state off
    else
      set_state on
    fi
    ;;
  *)
    echo "Usage: $0 [toggle|on|off|status]" >&2
    exit 1
    ;;
esac
