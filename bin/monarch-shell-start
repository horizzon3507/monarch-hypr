#!/bin/bash

# monarch:summary=Start the Hyprland desktop shell components (idempotent)
# monarch:examples=monarch shell start

set -uo pipefail

start_once() {
  local proc=$1
  shift
  pgrep -x "$proc" >/dev/null 2>&1 && return 0
  uwsm-app -t service -- "$@" >/dev/null 2>&1 &
}

monarch-theme-apply >/dev/null 2>&1 || true

start_once hyprpaper hyprpaper
start_once mako mako
start_once swayosd-server swayosd-server
start_once hypridle hypridle
start_once waybar waybar
if [[ -f "${XDG_STATE_HOME:-$HOME/.local/state}/monarch/toggles/bar-off" ]]; then
  monarch-toggle-bar off >/dev/null 2>&1 || true
fi
wait
