#!/bin/bash

# monarch:summary=Install Zed Editor and link the rendered Monarch theme

set -euo pipefail

echo "Installing Zed Editor..."
monarch-pkg-add zed

# Zed reads the Monarch theme rendered by monarch-theme-render (Monarch Dark and
# Monarch Light in one file). Link it so every re-render is picked up; Zed
# hot-reloads its themes/ dir. Schema-shaped, not yet checked in a running Zed.
mkdir -p "$HOME/.config/zed/themes"
ln -sfn "$HOME/.config/monarch/current/theme/zed.json" "$HOME/.config/zed/themes/monarch.json"
monarch-theme-render >/dev/null 2>&1 || true

# Fresh installs have no settings.json yet, so seed one that follows the system
# dark/light toggle; never rewrite an existing (JSONC) settings file.
zed_settings="$HOME/.config/zed/settings.json"
theme_block='"theme": { "mode": "system", "light": "Monarch Light", "dark": "Monarch Dark" }'
if [[ ! -f $zed_settings ]]; then
  printf '{\n  %s\n}\n' "$theme_block" > "$zed_settings"
elif ! grep -q '"Monarch ' "$zed_settings"; then
  echo "Note: set ${theme_block} in $zed_settings to follow the Monarch theme."
fi

setsid gtk-launch dev.zed.Zed
