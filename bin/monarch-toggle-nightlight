#!/bin/bash

# monarch:summary=Toggle nightlight screen temperature (not available yet)
# monarch:args=[toggle|on|off|status]
# monarch:examples=monarch toggle nightlight status

# Noctalia provided the night light. Nothing replaces it in the Hyprland desktop
# yet (a Hyprland-native tool such as hyprsunset has not been chosen or
# packaged), so this reports that plainly instead of failing silently. `status`
# keeps printing the JSON the bar and menu read, always off.

case "${1:-toggle}" in
  toggle | on | off)
    echo "Night light is not available yet: no replacement for the Noctalia night light is set up." >&2
    exit 1
    ;;
  status | --status)
    printf '{"enabled":false,"tooltip":"Night light is not available yet"}\n'
    ;;
  *)
    echo "Usage: $0 [toggle|on|off|status]" >&2
    exit 1
    ;;
esac
