#!/bin/bash

# monarch:summary=Toggle nightlight screen temperature (forced on/off) via hyprsunset
# monarch:args=[toggle|on|off|status]
# monarch:examples=monarch toggle nightlight | monarch toggle nightlight status

# hyprsunset has no state query, so this command owns the flag and prints it as
# JSON on `status`, which is all the bar indicator reads. The flag lives in the
# runtime dir because it mirrors live compositor state and dies with the session.

NIGHTLIGHT_TEMP=${MONARCH_NIGHTLIGHT_TEMP:-4000}

STATE_FILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/monarch/nightlight"

nightlight_forced() {
  [[ -f $STATE_FILE ]]
}

apply_state() {
  case "$1" in
    on)
      nightlight_forced && return 0
      hyprctl hyprsunset temperature "$NIGHTLIGHT_TEMP" >/dev/null 2>&1 || return 1
      mkdir -p "$(dirname "$STATE_FILE")"
      touch "$STATE_FILE"
      ;;
    off)
      nightlight_forced || return 0
      hyprctl hyprsunset identity >/dev/null 2>&1 || return 1
      rm -f "$STATE_FILE"
      ;;
  esac
  pkill -RTMIN+8 -x waybar 2>/dev/null || true
}

print_status() {
  if nightlight_forced; then
    printf '{"enabled":true,"tooltip":"Night light on - restore day temperature"}\n'
  else
    printf '{"enabled":false,"tooltip":"Night light off"}\n'
  fi
}

case "${1:-toggle}" in
  toggle)
    if nightlight_forced; then
      apply_state off
    else
      apply_state on
    fi
    ;;
  on)
    apply_state on
    ;;
  off)
    apply_state off
    ;;
  status | --status)
    print_status
    ;;
  *)
    echo "Usage: $0 [toggle|on|off|status]" >&2
    exit 1
    ;;
esac
