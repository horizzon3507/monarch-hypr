#!/bin/bash

# monarch:summary=Toggle Waybar visibility
# monarch:args=[toggle|on|off|status|apply]
# monarch:examples=monarch toggle bar | monarch toggle bar status

set -uo pipefail

STATE_FILE="$HOME/.local/state/monarch/toggles/bar-off"

bar_enabled() {
  [[ ! -f $STATE_FILE ]]
}

# SIGUSR1 toggles Waybar's visibility, so only send it when the bar differs.
bar_visible() {
  pgrep -x waybar >/dev/null 2>&1 || return 1
  [[ ! -f "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/monarch/bar-hidden" ]]
}

set_bar() {
  local state=$1 current=on
  [[ -f $STATE_FILE ]] && current=off
  local runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/monarch"

  pgrep -x waybar >/dev/null 2>&1 || return 1
  mkdir -p "$runtime"
  if [[ $state == "on" && -f $runtime/bar-hidden ]]; then
    pkill -SIGUSR1 -x waybar && rm -f "$runtime/bar-hidden"
  elif [[ $state == "off" && ! -f $runtime/bar-hidden ]]; then
    pkill -SIGUSR1 -x waybar && touch "$runtime/bar-hidden"
  fi

  if [[ $state != "$current" ]]; then
    monarch-toggle bar-off || return 1
  fi
}

wait_for_shell() {
  local attempt

  for ((attempt = 0; attempt < 50; attempt++)); do
    pgrep -x waybar >/dev/null 2>&1 && return 0
    sleep 0.1
  done

  return 1
}

print_status() {
  if bar_enabled; then
    printf '{"enabled":true,"tooltip":"Menu bar visible - hide it"}\n'
  else
    printf '{"enabled":false,"tooltip":"Menu bar hidden - show it"}\n'
  fi
}

case "${1:-toggle}" in
  toggle)
    if bar_enabled; then
      set_bar off
    else
      set_bar on
    fi
    ;;
  on)
    set_bar on
    ;;
  off)
    set_bar off
    ;;
  apply)
    wait_for_shell || exit 1
    if bar_enabled; then
      set_bar on
    else
      set_bar off
    fi
    ;;
  status | --status)
    print_status
    ;;
  *)
    echo "Usage: $0 [toggle|on|off|status|apply]" >&2
    exit 1
    ;;
esac
