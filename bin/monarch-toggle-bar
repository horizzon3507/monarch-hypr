#!/bin/bash

# monarch:summary=Toggle the Quickshell bar visibility
# monarch:args=[toggle|on|off|status|apply]
# monarch:examples=monarch toggle bar | monarch toggle bar status

set -uo pipefail

# barVisible lives in shell.json, which the shell watches. The state flag stays
# the user's record of the choice, so "apply" can restore it after a reset.
STATE_FILE="$HOME/.local/state/monarch/toggles/bar-off"

bar_enabled() {
  [[ ! -f $STATE_FILE ]]
}

set_bar() {
  local state=$1 current=on value=true
  [[ -f $STATE_FILE ]] && current=off
  [[ $state == "off" ]] && value=false

  monarch-shell-setting set barVisible "$value" || return 1
  if [[ $state != "$current" ]]; then
    monarch-toggle bar-off || return 1
  fi
}

print_status() {
  if bar_enabled; then
    printf '{"enabled":true,"tooltip":"Menu bar visible - hide it"}\n'
  else
    printf '{"enabled":false,"tooltip":"Menu bar hidden - show it"}\n'
  fi
}

case "${1:-toggle}" in
  toggle)
    if bar_enabled; then set_bar off; else set_bar on; fi
    ;;
  on) set_bar on ;;
  off) set_bar off ;;
  apply)
    if bar_enabled; then set_bar on; else set_bar off; fi
    ;;
  status | --status) print_status ;;
  *)
    echo "Usage: $0 [toggle|on|off|status|apply]" >&2
    exit 1
    ;;
esac
