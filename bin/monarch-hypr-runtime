#!/bin/bash

# monarch:summary=Read/write Monarch's generated Hyprland runtime overrides (input on-off, per-output scale and on-off)
# monarch:args=input <touchpad|touch> <on|off|toggle> | output-scale <name> <scale> | output <name> <on|off|toggle>
# monarch:hidden=true

# Single owner of ~/.config/hypr/runtime.lua, the one generated file holding
# every runtime override Monarch applies to Hyprland (input device on-off,
# per-output scale and on-off). The session config loads it after monitors.lua, so overrides
# survive a reload. The file is rewritten and Hyprland is reloaded (hyprctl reload) to apply it. State is
# kept in `-- monarch-*` marker lines, so this file is the only record.

set -uo pipefail

FILE="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/runtime.lua"

touchpad_off=false
touch_off=false
declare -A out_scale=()
declare -A out_off=()
if [[ -f $FILE ]]; then
  while read -r marker key name value; do
    case "$marker:$key" in
      "--:monarch-input")
        [[ $name == touchpad ]] && touchpad_off=true
        [[ $name == touch ]] && touch_off=true
        ;;
      "--:monarch-scale") out_scale["$name"]="$value" ;;
      "--:monarch-off") out_off["$name"]=true ;;
    esac
  done <"$FILE"
fi

# Mode and position of an output as it is now, so a scale change keeps the layout.
monitor_spec() {
  hyprctl monitors all -j 2>/dev/null | jq -r --arg n "$1" '
    .[] | select(.name == $n) | "\(.width)x\(.height)@\(.refreshRate)\t\(.x)x\(.y)"' | head -n1
}

input_devices() {
  local kind=$1
  case "$kind" in
    touchpad) hyprctl devices -j 2>/dev/null | jq -r '.mice[] | select(.name | test("touchpad"; "i")) | .name' ;;
    touch) hyprctl devices -j 2>/dev/null | jq -r '.touch[]?.name' ;;
  esac
}

regenerate_and_reload() {
  mkdir -p "$(dirname "$FILE")"
  local tmp name spec mode pos kind device
  tmp=$(mktemp "${FILE}.XXXXXX") || return 1
  {
    echo "-- GENERATED by Monarch. Do not edit:"
    echo "-- rewritten by monarch-toggle-touchpad / monarch-toggle-touchscreen"
    echo "-- (device on-off) and monarch-display-scale / monarch-display-toggle"
    echo "-- (per-output scale and on-off). Your own settings in monitors.lua load earlier."
    for kind in touchpad touch; do
      if [[ $kind == touchpad && $touchpad_off == true ]] || [[ $kind == touch && $touch_off == true ]]; then
        echo "-- monarch-input $kind off"
        while IFS= read -r device; do
          [[ -n $device ]] || continue
          printf 'hl.device({ name = "%s", enabled = false })\n' "$device"
        done < <(input_devices "$kind")
      fi
    done
    local names
    mapfile -t names < <(printf '%s\n' "${!out_scale[@]}" "${!out_off[@]}" | grep -v '^$' | sort -u)
    for name in "${names[@]}"; do
      [[ -n ${out_scale[$name]:-} ]] && echo "-- monarch-scale $name ${out_scale[$name]}"
      [[ -n ${out_off[$name]:-} ]] && echo "-- monarch-off $name"
      if [[ -n ${out_off[$name]:-} ]]; then
        echo "hl.monitor({ output = \"$name\", disabled = true })"
      else
        spec=$(monitor_spec "$name")
        mode=${spec%%$'\t'*}
        pos=${spec#*$'\t'}
        [[ -n $spec ]] || { mode=preferred; pos=auto; }
        echo "hl.monitor({ output = \"$name\", mode = \"$mode\", position = \"$pos\", scale = ${out_scale[$name]:-1} })"
      fi
    done
  } >"$tmp"
  mv -f "$tmp" "$FILE" || return 1

  if pgrep -x Hyprland >/dev/null 2>&1; then
    hyprctl reload >/dev/null 2>&1 || true
  fi
}

usage() {
  echo "usage: $(basename "$0") input <touchpad|touch> <on|off|toggle>" >&2
  echo "       $(basename "$0") output-scale <name> <scale>" >&2
  echo "       $(basename "$0") output <name> <on|off|toggle>" >&2
  exit 1
}

case "${1:-}" in
  input)
    device="${2:-}"
    action="${3:-toggle}"
    case "$device" in
      touchpad) cur=$touchpad_off ;;
      touch) cur=$touch_off ;;
      *) usage ;;
    esac
    case "$action" in
      on) new=false ;;
      off) new=true ;;
      toggle) if $cur; then new=false; else new=true; fi ;;
      *) usage ;;
    esac
    if [[ $device == touchpad ]]; then touchpad_off=$new; else touch_off=$new; fi
    regenerate_and_reload
    $new && echo "disabled" || echo "enabled"
    ;;
  output-scale)
    name="${2:-}"
    scale="${3:-}"
    [[ -z $name || -z $scale ]] && usage
    [[ $scale =~ ^[0-9]+(\.[0-9]+)?$ ]] || usage
    out_scale["$name"]="$scale"
    regenerate_and_reload
    ;;
  output)
    name="${2:-}"
    action="${3:-toggle}"
    [[ -z $name ]] && usage
    case "$action" in
      on) unset 'out_off[$name]' ;;
      off) out_off["$name"]=true ;;
      toggle)
        if [[ -n ${out_off[$name]:-} ]]; then unset 'out_off[$name]'; else out_off["$name"]=true; fi
        ;;
      *) usage ;;
    esac
    regenerate_and_reload
    [[ -n ${out_off[$name]:-} ]] && echo "off" || echo "on"
    ;;
  *) usage ;;
esac
