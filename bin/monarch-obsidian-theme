#!/bin/bash

# monarch:summary=Apply the Monarch theme to newly discovered Obsidian vaults
# monarch:hidden=true

# Links the Monarch snippet rendered by monarch-theme-render into each vault and
# enables it, leaving other snippets and settings alone. Safe to run again: a
# vault that is already set up is not changed. Runs from the
# monarch-obsidian-theme user service, so it must not depend on a desktop
# session's environment. Obsidian 1.15.1 follows the symlinked snippet when it
# is enabled before Obsidian starts (VM probe, see docs/fork-status.md); changes
# made while Obsidian is running were not checked.

mapfile -t vaults < <(find "$HOME" -maxdepth 4 -name .obsidian -type d 2>/dev/null | sort -u)
((${#vaults[@]})) || exit 0

rendered="$HOME/.config/monarch/current/theme/obsidian.css"
[[ -f $rendered ]] || monarch-theme-render >/dev/null 2>&1 || true
[[ -f $rendered ]] || { echo "The Monarch Obsidian snippet has not been rendered" >&2; exit 1; }

status=0
for vault in "${vaults[@]}"; do
  mkdir -p "$vault/snippets" && ln -sfn "$rendered" "$vault/snippets/monarch.css" || { status=1; continue; }
  appearance="$vault/appearance.json"
  if [[ ! -f $appearance ]]; then
    printf '{\n  "enabledCssSnippets": ["monarch"]\n}\n' >"$appearance" || status=1
  elif ! jq -e '.enabledCssSnippets // [] | index("monarch") != null' "$appearance" >/dev/null 2>&1; then
    tmp=$(mktemp "$vault/.appearance.XXXXXX") || { status=1; continue; }
    if jq '.enabledCssSnippets = ((.enabledCssSnippets // []) + ["monarch"])' "$appearance" >"$tmp" 2>/dev/null; then
      mv -f "$tmp" "$appearance" || status=1
    else
      rm -f "$tmp"
      echo "Could not enable the Monarch snippet in $appearance" >&2
      status=1
    fi
  fi
done
exit "$status"
