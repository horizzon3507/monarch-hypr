#!/bin/bash

# monarch:summary=Enable, disable, or toggle the touchpad
# monarch:args=[on|off|toggle|status]

if [[ -z "$(monarch-hw-touchpad)" ]]; then
  echo "No touchpad device found" >&2
  exit 1
fi

if [[ ${1:-toggle} == "status" || ${1:-toggle} == "--status" ]]; then
  if grep -qxF -- '-- monarch-input touchpad off' "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/runtime.lua" 2>/dev/null; then
    printf '{"enabled":false,"tooltip":"Touchpad disabled - enable it"}\n'
  else
    printf '{"enabled":true,"tooltip":"Touchpad enabled - disable it"}\n'
  fi
  exit 0
fi

# The toggle is driven through the Hyprland runtime file (see
# monarch-hypr-input-toggle), which disables the device rather than
# the kernel's unreliable sysfs `inhibited` attribute.
exec monarch-hypr-input-toggle touchpad "${1:-toggle}"
