#!/bin/bash

# monarch:summary=Install Helix and configure it to follow the Monarch theme

echo "Installing Helix..."
monarch-pkg-add helix

mkdir -p ~/.config/helix/themes

# Helix reads the Monarch theme rendered by monarch-theme-render. Link it so every
# re-render is picked up. Only seed config.toml if the user has none. The theme is
# schema-shaped and has not been checked in a running Helix.
ln -sfn "$HOME/.config/monarch/current/theme/helix.toml" ~/.config/helix/themes/monarch.toml
monarch-theme-render >/dev/null 2>&1 || true
if [[ ! -f ~/.config/helix/config.toml ]]; then
  printf 'theme = "monarch"\n' >~/.config/helix/config.toml
elif ! grep -q '^theme *= *"monarch"' ~/.config/helix/config.toml; then
  echo 'Note: set theme = "monarch" in ~/.config/helix/config.toml to use the Monarch theme.'
fi

# Arch-based distros ship Helix as 'helix' rather than the upstream 'hx'.
if ! grep -q '^alias hx="helix"' ~/.bashrc 2>/dev/null; then
  echo 'alias hx="helix"' >>~/.bashrc
fi
