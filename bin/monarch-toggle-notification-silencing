#!/bin/bash

# monarch:summary=Toggle notification do-not-disturb mode (mako)
# monarch:args=[toggle|on|off|status]
# monarch:examples=monarch toggle notification-silencing status

# Same shape as monarch-toggle-idle and monarch-toggle-nightlight, minus the
# state file: mako owns the state as its `do-not-disturb` mode (defined in
# config/mako/config; critical notifications still show), so there is no
# Monarch-side flag to drift. `status` reports what mako says.

mode=do-not-disturb

dnd_on() {
  makoctl mode 2>/dev/null | grep -qx "$mode"
}

print_status() {
  if dnd_on; then
    printf '{"enabled":true,"tooltip":"Do not disturb - allow notifications"}\n'
  else
    printf '{"enabled":false,"tooltip":"Silence notifications"}\n'
  fi
}

case "${1:-toggle}" in
  toggle)
    if dnd_on; then makoctl mode -r "$mode" >/dev/null 2>&1; else makoctl mode -a "$mode" >/dev/null 2>&1; fi
    ;;
  on)
    dnd_on || makoctl mode -a "$mode" >/dev/null 2>&1
    ;;
  off)
    ! dnd_on || makoctl mode -r "$mode" >/dev/null 2>&1
    ;;
  status | --status)
    print_status
    ;;
  *)
    echo "Usage: $0 [toggle|on|off|status]" >&2
    exit 1
    ;;
esac
