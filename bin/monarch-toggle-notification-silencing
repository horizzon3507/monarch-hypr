#!/bin/bash

# monarch:summary=Toggle notification do-not-disturb mode via Mako
# monarch:args=[toggle|on|off|status]
# monarch:examples=monarch toggle notification-silencing status

# Mako is the single source of truth: do-not-disturb is its "do-not-disturb" mode.

print_status() {
  if [[ $(makoctl mode 2>/dev/null) == *do-not-disturb* ]]; then
    printf '{"enabled":true,"tooltip":"Do not disturb - allow notifications"}\n'
  else
    printf '{"enabled":false,"tooltip":"Silence notifications"}\n'
  fi
}

case "${1:-toggle}" in
  toggle)
    makoctl mode -t do-not-disturb >/dev/null 2>&1
    ;;
  on)
    makoctl mode -a do-not-disturb >/dev/null 2>&1
    ;;
  off)
    makoctl mode -r do-not-disturb >/dev/null 2>&1
    ;;
  status | --status)
    print_status
    ;;
  *)
    echo "Usage: $0 [toggle|on|off|status]" >&2
    exit 1
    ;;
esac
