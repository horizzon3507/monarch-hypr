#!/bin/bash

# monarch:summary=Enable, disable, or toggle a Hyprland input device class
# monarch:args=<touchpad|touch> [on|off|toggle]
# monarch:hidden=true

# Backs monarch-toggle-touchpad / monarch-toggle-touchscreen. The actual state
# lives in ~/.config/hypr/runtime.lua, owned by monarch-hypr-runtime, which writes
# an `hl.device({ name = ..., enabled = false })` entry per device (hl.device is
# documented but its runtime effect is unverified on 0.57.2) instead of poking
# the kernel's unreliable sysfs `inhibited` attribute.

device="${1:-}"
action="${2:-toggle}"

case "$device" in
  touchpad | touch) ;;
  *)
    echo "usage: $(basename "$0") <touchpad|touch> [on|off|toggle]" >&2
    exit 1
    ;;
esac

state=$(monarch-hypr-runtime input "$device" "$action") || exit 1

case "$device" in
  touchpad) notify-send -u low "  Touchpad $state" ;;
  touch) notify-send -u low "󰟸  Touchscreen $state" ;;
esac
