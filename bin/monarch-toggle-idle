#!/bin/bash

# monarch:summary=Toggle idle locking (hypridle)
# monarch:args=[toggle|on|off|status|claim <owner>|release <owner>]
# monarch:examples=monarch toggle idle | monarch toggle idle status

# Staying awake stops hypridle; allowing idle starts it again. This command owns
# the state because hypridle cannot report it, and prints it as JSON on `status`.
# The flag lives in the runtime dir because it mirrors live session state and
# must die with the session; monarch-shell-restart clears it.
# Lid-close lock is handled separately by the compositor and is unaffected.

STATE_FILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/monarch/caffeine"

caffeine_enabled() {
  [[ -f $STATE_FILE ]]
}

apply_state() {
  local owner="${2:-user}"

  case "$1" in
    on)
      mkdir -p "$(dirname "$STATE_FILE")"
      if caffeine_enabled; then
        printf '%s\n' "$owner" >"$STATE_FILE"
        pkill -RTMIN+9 -x waybar 2>/dev/null || true
        return
      fi
      printf '%s\n' "$owner" >"$STATE_FILE"
      pkill -x hypridle 2>/dev/null || true
      ;;
    off)
      rm -f "$STATE_FILE"
      pgrep -x hypridle >/dev/null 2>&1 || { setsid --fork hypridle >/dev/null 2>&1 || return 1; }
      ;;
  esac
  pkill -RTMIN+9 -x waybar 2>/dev/null || true
}

print_status() {
  if caffeine_enabled; then
    printf '{"enabled":true,"tooltip":"Caffeine on - allow idle lock"}\n'
  else
    printf '{"enabled":false,"tooltip":"Stay awake"}\n'
  fi
}

case "${1:-toggle}" in
  toggle)
    if caffeine_enabled; then
      apply_state off
    else
      apply_state on
    fi
    ;;
  on | stay-awake)
    apply_state on user
    ;;
  off | allow-idle)
    apply_state off
    ;;
  claim)
    owner="${2:-}"
    [[ $owner =~ ^[A-Za-z0-9:._-]+$ ]] || { echo "Invalid Caffeine owner" >&2; exit 2; }
    if ! caffeine_enabled; then
      apply_state on "$owner"
    else
      exit 1
    fi
    ;;
  release)
    owner="${2:-}"
    [[ $owner =~ ^[A-Za-z0-9:._-]+$ ]] || { echo "Invalid Caffeine owner" >&2; exit 2; }
    if [[ -f $STATE_FILE && $(<"$STATE_FILE") == $owner ]]; then
      apply_state off
    fi
    ;;
  status | --status)
    print_status
    ;;
  *)
    echo "Usage: $0 [toggle|on|off|status|claim <owner>|release <owner>]" >&2
    exit 1
    ;;
esac
