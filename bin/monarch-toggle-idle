#!/bin/bash

# monarch:summary=Toggle idle locking (caffeine: a held idle inhibitor)
# monarch:args=[toggle|on|off|status|claim <owner>|release <owner>]
# monarch:examples=monarch toggle idle | monarch toggle idle status

# This command owns the caffeine *state* and prints it as JSON on `status`, which
# is what the bar indicator and the menu read. Caffeine is a held logind idle
# inhibitor (hypridle honors it unless ignore_systemd_inhibit is set, which
# Monarch's hypridle.conf does not do). It pauses the idle screensaver, lock and
# DPMS only: hypridle keeps running, so a manual lock, before_sleep and
# after_sleep handling still work.
#
# The inhibitor is `systemd-inhibit ... sleep infinity` in its own session; its
# pid is kept beside the state file and is only ever signalled after its command
# line is checked, so a recycled pid is never killed. Both files live in the
# runtime dir and die with the session: a fresh session always starts with
# caffeine off, and monarch-restart-shell clears them for the same reason.

STATE_FILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/monarch/caffeine"
PID_FILE="$STATE_FILE.pid"

inhibitor_alive() {
  local pid cmdline
  [[ -f $PID_FILE ]] || return 1
  pid=$(<"$PID_FILE") || return 1
  [[ $pid =~ ^[1-9][0-9]*$ ]] || return 1
  [[ -r /proc/$pid/cmdline ]] || return 1
  cmdline=$(tr '\0' ' ' <"/proc/$pid/cmdline") || return 1
  [[ $cmdline == *systemd-inhibit* && $cmdline == *--who=monarch* && $cmdline == *--why=caffeine* ]]
}

start_inhibitor() {
  local attempt
  rm -f "$PID_FILE"
  command -v systemd-inhibit >/dev/null 2>&1 || { echo "systemd-inhibit is not available" >&2; return 1; }
  # `exec` keeps the shell's pid (and process group, from setsid) on the inhibitor.
  setsid -f bash -c 'printf "%s\n" "$$" >"$1"; exec systemd-inhibit --what=idle --who=monarch --why=caffeine --mode=block sleep infinity' _ "$PID_FILE" >/dev/null 2>&1 || return 1
  for ((attempt = 0; attempt < 20; attempt++)); do
    inhibitor_alive && return 0
    sleep 0.1
  done
  stop_inhibitor
  echo "The idle inhibitor did not start" >&2
  return 1
}

stop_inhibitor() {
  local pid
  if inhibitor_alive; then
    pid=$(<"$PID_FILE")
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
  fi
  rm -f "$PID_FILE"
}

caffeine_enabled() {
  [[ -f $STATE_FILE ]] || return 1
  inhibitor_alive && return 0
  # A flag whose inhibitor is gone is stale: report off and clean it up.
  rm -f "$STATE_FILE" "$PID_FILE"
  return 1
}

apply_state() {
  local owner="${2:-user}"

  case "$1" in
    on)
      mkdir -p "$(dirname "$STATE_FILE")"
      if ! caffeine_enabled; then
        start_inhibitor || return 1
      fi
      printf '%s\n' "$owner" >"$STATE_FILE"
      ;;
    off)
      stop_inhibitor
      rm -f "$STATE_FILE"
      ;;
  esac
}

print_status() {
  if caffeine_enabled; then
    printf '{"enabled":true,"tooltip":"Caffeine on - allow idle lock"}\n'
  else
    printf '{"enabled":false,"tooltip":"Stay awake"}\n'
  fi
}

case "${1:-toggle}" in
  toggle)
    if caffeine_enabled; then
      apply_state off
    else
      apply_state on
    fi
    ;;
  on | stay-awake)
    apply_state on user
    ;;
  off | allow-idle)
    apply_state off
    ;;
  claim)
    owner="${2:-}"
    [[ $owner =~ ^[A-Za-z0-9:._-]+$ ]] || { echo "Invalid Caffeine owner" >&2; exit 2; }
    if ! caffeine_enabled; then
      apply_state on "$owner"
    else
      exit 1
    fi
    ;;
  release)
    owner="${2:-}"
    [[ $owner =~ ^[A-Za-z0-9:._-]+$ ]] || { echo "Invalid Caffeine owner" >&2; exit 2; }
    if caffeine_enabled && [[ $(<"$STATE_FILE") == "$owner" ]]; then
      apply_state off
    fi
    ;;
  status | --status)
    print_status
    ;;
  *)
    echo "Usage: $0 [toggle|on|off|status|claim <owner>|release <owner>]" >&2
    exit 1
    ;;
esac
