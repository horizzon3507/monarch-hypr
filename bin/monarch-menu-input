#!/bin/bash

# monarch:summary=Prompt for text input from the Monarch menu
# monarch:group=menu
# monarch:name=input
# monarch:args=[prompt]
# monarch:examples=monarch menu input Reminder|monarch-menu-input "Reminder in minutes"

set -euo pipefail

prompt="${1:-}"
[[ -n $prompt ]] || prompt=$(jq -r '.["menu.input"] // "Input"' < <("${BASH_SOURCE[0]%/*}/monarch-menu" --strings))

# Walker's input-only dmenu returns what was typed.
text=$(walker --dmenu --inputonly --placeholder "${prompt:-Input}" </dev/null) || exit 1
[[ -n $text ]] || exit 1
printf '%s' "$text"
