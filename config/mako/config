include=~/.config/monarch/current/theme/mako.ini

anchor=top-right
default-timeout=5000
width=420
outer-margin=20
padding=10,15
border-size=2
max-icon-size=32
font=monospace 11

[app-name=notify-send]
format=<b>%s</b>\n%b

[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb urgency=critical]
invisible=0
